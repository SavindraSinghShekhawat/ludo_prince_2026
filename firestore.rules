rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ── Users Collection ───────────────────────────────────────────────────
    match /users/{userId} {
      // Must be authenticated to read user profiles (prevents unauthorized scraping)
      allow read: if isAuthenticated();
      
      // Creating profile:
      // Client can ONLY initialize basic profile info (displayName, email, photoURL, createdAt).
      // Client is STRICTLY FORBIDDEN from writing game stats (gamesPlayed, gamesWon) or friendsCount.
      // Game numbers are 100% server-authoritative and managed exclusively via Cloud Functions.
      allow create: if isOwner(userId)
        && !('gamesPlayed' in request.resource.data)
        && !('gamesWon' in request.resource.data)
        && !('friendsCount' in request.resource.data);
      
      // Updating profile:
      // Client can only update displayName, email, photoURL, and lastActive.
      // Client is STRICTLY FORBIDDEN from modifying game stats, friendsCount, or createdAt.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'gamesPlayed', 
          'gamesWon', 
          'friendsCount', 
          'createdAt'
        ]);
        
      // Account deletion: Owner only
      allow delete: if isOwner(userId);
      
      // ── User's Friends Subcollection ─────────────────────────────────────
      match /friends/{friendId} {
        // Only the user themselves or the friend can view their friendship record
        allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == friendId);
        
        // Only the user can add or remove friends from their own friends subcollection
        allow create, delete: if isOwner(userId);
        
        // Friendship documents are immutable
        allow update: if false;
      }
    }
    
    // ── Friend Requests Collection ─────────────────────────────────────────
    match /friend_requests/{requestId} {
      // Only the sender or recipient can read the request
      allow read: if isAuthenticated() && (
        resource.data.from == request.auth.uid || resource.data.to == request.auth.uid
      );
      
      // Sending a friend request:
      // Must be sent from the authenticated user, cannot send to oneself, initial status MUST be 'pending'
      allow create: if isAuthenticated()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      
      // Responding to a friend request:
      // Only the recipient can accept or decline.
      // Must only update the 'status' field to 'accepted' or 'declined'.
      allow update: if isAuthenticated()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined');
        
      // Deleting a friend request:
      // Only the sender (canceling) or recipient (declining/dismissing) can delete
      allow delete: if isAuthenticated() && (
        resource.data.from == request.auth.uid || resource.data.to == request.auth.uid
      );
    }

    // ── Feedbacks Collection ───────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      // Write-only drop box: authenticated users can only submit feedback for their own account
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
        
      // No client can read, edit, or delete submitted feedback (admin console only)
      allow read, update, delete: if false;
    }
    
    // ── Default Deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
