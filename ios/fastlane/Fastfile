default_platform(:ios)

platform :ios do

  before_all do
    key_path = File.expand_path("../../.secrets/fastlane/ios/AuthKey_PSUDP28BN6.p8", __dir__)
    unless File.exist?(key_path)
      key_path = "/Volumes/Vault/Personal/workspace/evlome/.secrets/fastlane/ios/AuthKey_PSUDP28BN6.p8"
    end

    app_store_connect_api_key(
      key_id: "PSUDP28BN6",
      issuer_id: "de606a4c-f4e8-4a3b-9406-de2c3d3cc284",
      key_filepath: key_path,
      in_house: false
    )
  end

  desc "Test App Store Connect API Key Authentication"
  lane :test_auth do
    app_store_build_number(
      app_identifier: "com.paisphere.ludoprince"
    )
  end

  desc "Build iOS app"
  lane :build do
    sh("flutter clean")
    sh("flutter pub get")
    sh("flutter build ios --release")
  end

  desc "Upload build to TestFlight"
  lane :internal do
    build

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight
  end

  desc "Upload to App Store production"
  lane :production do
    version_line = File.readlines("../../pubspec.yaml").find { |l| l.start_with?("version:") }
    build_number = version_line.split("+")[1].strip

    UI.message("Releasing iOS build #{build_number}")

    upload_to_app_store(
      force: true,
      submit_for_review: true,
      automatic_release: true,
      build_number: build_number,
      skip_screenshots: true,
      skip_binary_upload: true,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "en-US" => "Bug fixes and performance improvements."
      }
    )
  end

end