{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "stats": {
      "onlineCount": {
        ".read": true,
        ".write": false 
      }
    },
    "ludogames": {
      ".indexOn": ["status"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$gameId": {
        "prefetchedRoll": {
          ".read": "auth != null && data.parent().child('players').child(data.parent().child('currentTurn').val()).child('uid').val() === auth.uid",
          ".write": false
        }
      }
    },
    "matchmaking": {
      "$mode": {
        "queue": {
          ".indexOn": ["joinedAt"],
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "matchmakingAssignments": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "privateRoomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    }
  }
}
