{
  "rules": {
    "games": {
      "$gameType": {
        ".indexOn": ["status", "joiningCode"],
        "$sessionId": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['status', 'players'])"
        }
      }
    },
    "matchmaking": {
      "$gameType": {
        "$mode": {
          "queue": {
            ".indexOn": ["joinedAt"],
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['joinedAt', 'name'])"
            }
          },
          "processing": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "matchmakingAssignments": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "privateRoomCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "stats": {
      "onlineCount": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
