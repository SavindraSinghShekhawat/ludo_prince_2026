{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node test/online_game_e2e.test.mjs",
    "test:e2e": "firebase emulators:exec --only database,firestore,functions --log-verbosity QUIET \"node test/online_game_e2e.test.mjs\"",
    "test:verbose": "firebase emulators:exec --only database,firestore,functions \"node test/online_game_e2e.test.mjs --verbose\""
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "firebase-functions-test": "^3.5.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true
}
